{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@backend/*": ["./src/backend/*"]
    },
    "noEmit": true
  },
  "include": ["server.ts", "src/backend/**/*", "src/shared/**/*"],
  "exclude": ["node_modules", "dist", "dist-server", "src/frontend"]
}
