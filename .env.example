# ==============================================================================
# YouTube Live Automation Studio — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development.
# NEVER commit real secrets, OAuth client secrets, or service account JSONs.

# ------------------------------------------------------------------------------
# Runtime & Server
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000

# Public URL where the backend server is reachable (used for CORS and OAuth callback fallback)
# Example on Render single-service: APP_BASE_URL="https://yt-live-stream-x53v.onrender.com"
APP_BASE_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Comma-separated list of allowed CORS origins for backend API requests.
# Example for Render deployment:
# CORS_ORIGINS="https://yt-live-stream-x53v.onrender.com,http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://yt-live-stream-x53v.onrender.com"

# Set to "true" when Render serves both the React SPA and /api from one Web Service;
# set to "false" when hosting the frontend separately on Render Static Site.
SERVE_STATIC="true"

# ------------------------------------------------------------------------------
# Firebase Client SDK (Vite Frontend Build-Time Variables)
# ------------------------------------------------------------------------------
# Note: Only non-secret Web SDK identifiers belong in VITE_* variables.
# In AI Studio, `/firebase-applet-config.json` provides defaults automatically;
# for Render Static Site deployments, set these VITE_FIREBASE_* env vars explicitly.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

# Base URL of the backend API when frontend is hosted separately (Render Static Site).
# Leave empty ("") when served from the same origin as the backend.
VITE_API_BASE_URL=""

# ------------------------------------------------------------------------------
# Firebase Admin SDK (Backend Server-Only Secrets)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_ID="(default)"

# Option A (Recommended for Render Web Service): Single-line JSON from
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Option B (Alternative to FIREBASE_SERVICE_ACCOUNT_JSON): Explicit pair
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# Multiple Authorized Gmail Admin Allowlist (Server-Side)
# ------------------------------------------------------------------------------
# Comma-separated list of approved Gmail/email addresses allowed to log in.
# The first email in ADMIN_EMAILS (or FIREBASE_ADMIN_EMAIL) is treated as the
# primary studio administrator and cannot be revoked via the UI.
ADMIN_EMAILS="admin1@gmail.com,admin2@gmail.com"
# Optional legacy single-admin alias (merged cleanly with ADMIN_EMAILS)
FIREBASE_ADMIN_EMAIL=""
FIREBASE_ADMIN_UID=""

# Optional: Only used transiently when running `npm run admin:setup`
# ADMIN_INITIAL_PASSWORD=""

# ------------------------------------------------------------------------------
# Primary Storage: Google Drive OAuth 2.0 & Token Encryption (Backend-Only)
# ------------------------------------------------------------------------------
# From Google Cloud Console -> Google Auth Platform / Credentials -> Web Application OAuth Client ID
# GOOGLE_CLIENT_ID must end with .apps.googleusercontent.com; NEVER place GOOGLE_CLIENT_SECRET in VITE_* vars.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Exact HTTPS Authorized Redirect URI registered in Google Cloud Console (required HTTPS in production):
# e.g. https://your-backend.onrender.com/api/v1/storage/google-drive/oauth/callback
GOOGLE_DRIVE_CALLBACK_URL=""

# 32-byte hex or strong random key (>= 32 chars) used for AES-256-GCM encryption
# of Google Drive OAuth refresh/access tokens in Firestore `storage_provider_secrets`.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_OAUTH_ENCRYPTION_KEY=""

# Optional fallback key if using secondary S3-compatible/GCS storage adapters
STORAGE_ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# Reserved Platform Variable
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
